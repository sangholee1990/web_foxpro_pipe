<%
Response.AddHeader("Content-Type", "text/html; charset=euc-kr")

LOCAL lcConnStr, lnHandle, lnResult, lcSQL, lnId
LOCAL lcTitle, lcContent, lcThumbnail, lcUserId, lcCreateDt, lnViews

lcConnStr = "Driver={MySQL ODBC 5.3 ANSI Driver};Server=49.247.41.71;Database=pipe;Uid=pipe;Pwd=pipe123!@;Port=3306;CharSet=euckr;Option=16384;"
lnHandle = SQLSTRINGCONNECT(lcConnStr)
lcRole = Request.QueryString("role")

lnId = VAL(Request.QueryString("id"))

IF lnId > 0
    SQLEXEC(lnHandle, "UPDATE Articles SET views = views + 1 WHERE id = ?lnId")
    lcSQL = "SELECT CAST(id AS CHAR(20)) AS id, CAST(title AS CHAR(255) CHARACTER SET euckr) AS title, " + ;
            "content, CAST(thumbnail AS CHAR(255) CHARACTER SET euckr) AS thumbnail, " + ;
            "CAST(user_id AS CHAR(20)) AS user_id, CAST(views AS CHAR(20)) AS views, " + ;
            "CAST(createDt AS CHAR(20)) AS createDt FROM Articles WHERE id = ?lnId"
            
    lnResult = SQLEXEC(lnHandle, lcSQL, "curArticle")
    IF lnResult > 0 AND NOT EOF("curArticle")
        lcTitle = curArticle.title
        lcContent = curArticle.content
        lcThumbnail = curArticle.thumbnail
        lcUserId = curArticle.user_id
        lcCreateDt = curArticle.createDt
        lnViews = curArticle.views
        USE IN curArticle
    ENDIF
ENDIF
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="euc-kr">
    <title><%= TRANSFORM(lcTitle) %></title>
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/quill.snow.css" />
    <link href="css/pretendard-gov.min.css" rel="stylesheet">
    <script src="js/sweetalert2@11.js"></script>
    <style>
        body, input, button, select, textarea, th, td { font-family: 'Pretendard GOV', sans-serif; }
        #detail .content-body { font-family: 'Pretendard GOV', sans-serif; min-height: 300px; padding: 20px; border: 1px solid #dee2e6; border-radius: 4px; background: #fff; }
        #detail h4, #detail span { font-family: 'Pretendard GOV', sans-serif !important; }
        .btn-board { font-family: 'Pretendard GOV', sans-serif !important; min-width: 90px; height: 34px; line-height: 22px; font-size: 15px; padding: 5px 14px; font-weight: 500; }
        .ql-editor { padding: 0; }
        .thumbnail-box { max-width: 100%; border-radius: 8px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-light p-4">

<div class="card mb-4" id="detail">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="m-0 fw-bold"><%= TRANSFORM(lcTitle) %></h4>
        <div>
            <span class="badge bg-secondary me-2">Views: <%= TRANSFORM(lnViews) %></span>
            <span class="text-muted small"><%= TRANSFORM(lcCreateDt) %></span>
        </div>
    </div>
    <div class="card-body">
        <% IF NOT EMPTY(lcThumbnail) %>
        <div class="text-center">
            <img src="<%= TRANSFORM(lcThumbnail) %>" class="thumbnail-box" alt="Thumbnail">
        </div>
        <% ENDIF %>
        <div class="content-body ql-editor">
            <%= lcContent %>
        </div>
    </div>
    <div class="card-footer text-center">
        <% IF LOWER(lcRole) = "admin" %>
        <a href="board_write.fwx?id=<%= TRANSFORM(lnId) %>&role=<%= lcRole %>" class="btn btn-sm btn-primary btn-board fw-bold mx-1">EDIT</a>
        <% ENDIF %>
        <a href="board_list.fwx?role=<%= lcRole %>" class="btn btn-sm btn-secondary btn-board fw-bold mx-1">LIST</a>
    </div>
</div>

<% SQLDISCONNECT(lnHandle) %>
</body>
</html>
