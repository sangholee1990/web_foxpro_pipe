<%
Response.AddHeader("Content-Type", "text/html; charset=euc-kr")

LOCAL lcConnStr, lnHandle, lnResult, lcSQL, lnId
LOCAL lcTitle, lcContent, lcThumbnail, lcUserId, lcCreateDt, lnViews

lcConnStr = "Driver={MySQL ODBC 5.3 ANSI Driver};Server=localhost;Database=pipe;Uid=pipe;Pwd=pipe123!@;Port=3306;CharSet=euckr;Option=16384;"
lnHandle = SQLSTRINGCONNECT(lcConnStr)
lcRole = Request.QueryString("role")

lnId = VAL(Request.QueryString("id"))

IF lnId > 0
    SQLEXEC(lnHandle, "UPDATE Articles SET views = views + 1 WHERE id = ?lnId")
    lcSQL = "SELECT CAST(id AS CHAR(20)) AS id, CAST(title AS CHAR(255) CHARACTER SET euckr) AS title, " + ;
            "content, CAST(thumbnail AS CHAR(255) CHARACTER SET euckr) AS thumbnail, " + ;
            "CAST(user_id AS CHAR(20)) AS user_id, CAST(views AS CHAR(20)) AS views, " + ;
            "CAST(createDt AS CHAR(20)) AS createDt FROM Articles WHERE id = ?lnId"
            
    lnResult = SQLEXEC(lnHandle, lcSQL, "curArticle")
    IF lnResult > 0 AND NOT EOF("curArticle")
        lcTitle = curArticle.title
        lcContent = curArticle.content
        lcThumbnail = curArticle.thumbnail
        lcUserId = curArticle.user_id
        lcCreateDt = curArticle.createDt
        lnViews = curArticle.views
        USE IN curArticle
    ELSE
        Response.Write("<html><head><script src='js/sweetalert2@11'></script></head><body><script>Swal.fire({position:'top-end',icon:'error',title:'존재하지 않는 글입니다.',showConfirmButton:false,timer:1500,toast:true,timerProgressBar:true}).then(()=>{location.href='board_list.fwx';});</script></body></html>")
        RETURN
    ENDIF
ELSE
    Response.Write("<html><head><script src='js/sweetalert2@11'></script></head><body><script>Swal.fire({position:'top-end',icon:'error',title:'잘못된 접근입니다.',showConfirmButton:false,timer:1500,toast:true,timerProgressBar:true}).then(()=>{location.href='board_list.fwx';});</script></body></html>")
    RETURN
ENDIF
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="euc-kr">
    <title>ARTICLE DETAIL</title>
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link href="css/quill.snow.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&family=Noto+Serif+KR:wght@400;700&family=Nanum+Gothic:wght@400;700&family=Nanum+Myeongjo:wght@400;700&family=Nanum+Gothic+Coding:wght@400;700&family=Black+Han+Sans&family=Jua&family=Do+Hyeon&family=Gothic+A1:wght@400;700&display=swap" rel="stylesheet">
    <link href="css/pretendard-gov.min.css" rel="stylesheet">
        <style>
        body, input, button, select, textarea, th, td { font-family: 'Pretendard GOV', sans-serif; }
        #detail .content-body { font-family: 'Pretendard GOV', sans-serif; }
        #detail h4, #clist .article-title { font-family: 'Pretendard GOV', sans-serif; }
        #detail span:not([class*='ql-font-']) { font-family: 'Pretendard GOV', sans-serif; }
        .ql-editor { font-size: 15px; white-space: normal; }
        /* Quill Font Family Mapping */
                .ql-editor         /* 상세 보기 폰트 강화 */
                                .ql-font-pretendard-gov { font-family: 'Pretendard GOV', sans-serif !important; }
        .ql-font-noto-sans-kr { font-family: 'Noto Sans KR', sans-serif !important; }
        .ql-font-noto-serif-kr { font-family: 'Noto Serif KR', sans-serif !important; }
        .ql-font-nanum-gothic { font-family: 'Nanum Gothic', sans-serif !important; }
        .ql-font-nanum-myeongjo { font-family: 'Nanum Myeongjo', sans-serif !important; }
        .ql-font-nanum-gothic-coding { font-family: 'Nanum Gothic Coding', monospace !important; }
        .ql-font-black-han-sans { font-family: 'Black Han Sans', sans-serif !important; }
        .ql-font-jua { font-family: 'Jua', sans-serif !important; }
        .ql-font-do-hyeon { font-family: 'Do Hyeon', sans-serif !important; }
        .ql-font-gothic-a1 { font-family: 'Gothic A1', sans-serif !important; }
        .ql-font-malgun-gothic { font-family: 'Malgun Gothic', sans-serif !important; }
        
        #article-body { font-family: 'Pretendard GOV', sans-serif; min-height: 400px; background-color: #fff; border: none; border-radius: 4px; }
        
            body.swal2-shown { overflow-y: scroll !important; padding-right: 0 !important; }
            .btn-board { font-family: 'Pretendard GOV', sans-serif !important; min-width: 90px; height: 34px; line-height: 22px; font-size: 15px; padding: 5px 14px; font-weight: 500; }
                    .ql-container.ql-snow, .ql-container.ql-snow *, .ql-snow.ql-container, .ql-snow .ql-editor { 
            border: none !important; 
            border-width: 0 !important; 
            outline: none !important; 
        }
    </style>
        <script>
        function deleteArticle() {
            Swal.fire({
                title: '삭제 확인',
                text: '정말로 삭제하시겠습니까?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '삭제',
                cancelButtonText: '취소',
                scrollbarPadding: false
            }).then(function(result) {
                if (result.isConfirmed) {
                    location.href = 'board_action.fwx?action=delete&id=<%= TRANSFORM(lnId) %>&role=<%= lcRole %>';
                }
            });
        }
    </script>
    <script src="js/sweetalert2@11.js"></script>
</head>
<body class="bg-light p-4">

<div class="card mb-4" id="detail">
        <div class="card-header d-flex justify-content-between align-items-center">
        <div class="fw-bold my-auto">ARTICLE DETAIL</div>
        <div class="d-flex gap-1">
            <button type="button" class="btn btn-sm btn-secondary btn-board" onclick="location.href='board_list.fwx?role=<%= lcRole %>'">LIST</button>
            <% IF LOWER(lcRole) = "admin" %>
            <button type="button" class="btn btn-sm btn-primary btn-board" onclick="location.href='board_write.fwx?id=<%= TRANSFORM(lnId) %>&role=<%= lcRole %>'">EDIT</button>
            <button type="button" class="btn btn-sm btn-danger btn-board" onclick="deleteArticle()">DELETE</button>
            <% ENDIF %>
        </div>
    </div>
    <div class="card-body">
        <div class="post-content px-3 pt-0 mb-2 border rounded pb-4 bg-white">
            <div class="pb-3 border-bottom mb-3 d-flex justify-content-between align-items-center pt-3">
                <h4 class="mb-0 fw-bold my-auto"><%= TRANSFORM(lcTitle) %></h4>
                <div class="text-muted small my-auto">
                    
                    <span class="mx-3">Date: <%= LEFT(TRANSFORM(lcCreateDt), 16) %></span> |
                    <span class="ms-3">Views: <%= TRANSFORM(lnViews) %></span>
                </div>
            </div>

            <% IF NOT EMPTY(lcThumbnail) %>
            <div class="mb-4 text-center">
                <img src="<%= TRANSFORM(lcThumbnail) %>" alt="Thumbnail" class="img-fluid rounded" style="max-height: 400px;">
            </div>
            <% ENDIF %>

            <div class="content-body ql-snow ql-container" style="min-height: 300px;">
                <div class="ql-editor p-0">
                    <%= lcContent %>
                </div>
            </div>
        </div>

        <div class="row px-2 text-center mt-3">
            <div class="col-12 mt-2">
                <button type="button" class="btn btn-sm btn-secondary btn-board" onclick="location.href='board_list.fwx?role=<%= lcRole %>'">LIST</button>
                <% IF LOWER(lcRole) = "admin" %>
                <button type="button" class="btn btn-sm btn-primary btn-board" onclick="location.href='board_write.fwx?id=<%= TRANSFORM(lnId) %>&role=<%= lcRole %>'">EDIT</button>
                <button type="button" class="btn btn-sm btn-danger btn-board" onclick="deleteArticle()">DELETE</button>
                <% ENDIF %>
            </div>
        </div>
    </div>
</div>

<% SQLDISCONNECT(lnHandle) %>
</body>
</html>
